{
  "name": "@forma-ai/upgrade-impact",
  "version": "0.0.1",
  "private": true,
  "description": "Repository-specific dependency upgrade impact reports.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "analyse": "node scripts/analyse-prepared.ts",
    "action": "node scripts/run-github-action.ts",
    "check": "node --run typecheck && node --run test",
    "cli": "node src/cli.ts",
    "eval:acquire": "node scripts/acquire-evals.ts",
    "eval:applicability": "node scripts/validate-applicability-graphs.ts",
    "eval:drafts": "node scripts/build-deterministic-drafts.ts",
    "eval:evidence": "node scripts/build-evidence-packs.ts",
    "eval:inputs": "node scripts/build-analysis-inputs.ts",
    "eval:models": "node scripts/benchmark-models.ts",
    "eval:models:validate": "node scripts/validate-model-benchmark.ts",
    "eval:releases": "node scripts/build-release-evidence.ts",
    "eval:summarize": "node scripts/summarize-evals.ts",
    "eval:validate": "node scripts/validate-manual-evals.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.16.0"
}
